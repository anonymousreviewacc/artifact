<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Category and AI Indicator Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/dialog_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Category: SQL Injection"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/dialog_ai_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Generated 🤖"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Target -->
    <TextView
        android:id="@+id/dialog_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target: example.com"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"/>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/dialog_timestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generated: 15/12/2024 10:30"
        android:textSize="12sp"
        android:textColor="#999999"
        android:layout_marginBottom="16dp"/>

    <!-- Payload Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Payload:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="4dp"/>

    <!-- Payload Content (Scrollable) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp"
        android:background="#f8f8f8"
        android:padding="8dp">

        <TextView
            android:id="@+id/dialog_payload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="' OR '1'='1' --"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#333333"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true"/>

    </androidx.core.widget.NestedScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/dialog_btn_copy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="📋 Copy"
            android:textSize="16sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/dialog_btn_share"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="📤 Share"
            android:textSize="16sp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>