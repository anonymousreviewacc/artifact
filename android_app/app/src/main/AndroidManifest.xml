<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 🔴 REQUIRED FOR ANDROID 11+ (THIS FIXES TERMUX ISSUE) -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <!-- Internet permission (APIs, testing servers, updates) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="PlGenN"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlGenn"
        tools:targetApi="31">

        <!-- ================= HOME (ENTRY POINT) ================= -->
        <activity
            android:name="com.example.plgenn.ui.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ================= RULE-BASED GENERATOR ================= -->
        <activity
            android:name="com.example.plgenn.ui.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="singleTop" />

        <!-- ================= GNN / HYBRID GENERATOR ================= -->
        <activity
            android:name="com.example.plgenn.ui.GNNActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ================= PAYLOAD TESTING ================= -->
        <activity
            android:name="com.example.plgenn.ui.TestingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ================= PAYLOAD DETAIL ================= -->
        <activity
            android:name="com.example.plgenn.ui.PayloadDetailActivity"
            android:exported="false" />

        <!-- ================= LLM / FUTURE ================= -->
        <activity
            android:name="com.example.plgenn.ui.LLMActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
